        <div class="field">
          <input type="text" id="rsvpName" name="name" placeholder=" " required autocomplete="name">
          <label for="rsvpName">Full Name</label>
        </div>

        <div class="field">
          <select id="rsvpGuests" name="guests" required>
            <option value="" disabled selected hidden></option>
            <option value="1">Just me</option>
            <option value="2">2 guests</option>
            <option value="3">3 guests</option>
            <option value="4">4 guests</option>
            <option value="5">5+ guests</option>
          </select>
          <label for="rsvpGuests">Number of Guests</label>
        </div>

        <fieldset class="field field-toggle">
          <legend>Will you attend?</legend>
          <div class="toggle-group" role="radiogroup" aria-label="Will you attend?">
            <input type="radio" id="attendYes" name="attending" value="yes" checked>
            <label for="attendYes">Joyfully Accept</label>
            <input type="radio" id="attendNo" name="attending" value="no">
            <label for="attendNo">Regretfully Decline</label>
          </div>
        </fieldset>

        <div class="field" id="mealField">
          <select id="rsvpMeal" name="meal">
            <option value="" disabled selected hidden></option>
            <option value="vegetarian">Vegetarian</option>
            <option value="non-vegetarian">Non-Vegetarian</option>
            <option value="jain">Jain</option>
          </select>
          <label for="rsvpMeal">Meal Preference</label>
        </div>

        <div class="field">
          <textarea id="rsvpMessage" name="message" placeholder=" " rows="3"></textarea>
          <label for="rsvpMessage">A note for the couple (optional)</label>
        </div>

        <button type="submit" class="btn btn-gold rsvp-submit" id="rsvpSubmit">
          <span class="btn-text">Send RSVP</span>
          <span class="btn-spinner" aria-hidden="true"></span>
        </button>
      </form>

      <div class="rsvp-success" id="rsvpSuccess" role="status" aria-live="polite" hidden>
        <svg viewBox="0 0 52 52" class="rsvp-check"><circle cx="26" cy="26" r="24" fill="none"/><path fill="none" d="M14 27l7 7 17-17"/></svg>
        <h3>Thank you</h3>
        <p>Your response has been received with love. We can&rsquo;t wait to celebrate with you.</p>
      </div>
    </div>
  </section>

